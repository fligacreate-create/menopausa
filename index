<script>
  document.addEventListener('DOMContentLoaded', function () {
    const form = document.getElementById('fdlFormularioMenopausa');
    const dadosContacto = document.getElementById('fdlDadosContacto');
    const botao = document.getElementById('fdlBotaoEnviarMenopausa');
    const mensagem = document.getElementById('fdlMensagemMenopausa');

    const questaoLivre = document.getElementById('fdlQuestaoLivre');
    const contador = document.getElementById('fdlContadorCaracteres');

    const campoNome = document.getElementById('fdlNome');
    const campoTelefone = document.getElementById('fdlTelefone');
    const campoMelhorDia = document.getElementById('fdlMelhorDia');
    const campoMelhorHorario = document.getElementById('fdlMelhorHorario');
    const campoConsentimento = document.getElementById('fdlConsentimento');

    /* COLE AQUI O URL DA VOSSA APLICAÇÃO WEB APPS SCRIPT, TERMINADO EM /exec */
    const SCRIPT_URL = 'COLE_AQUI_O_URL_TERMINADO_EM_EXEC';

    function atualizarContador() {
      contador.textContent = questaoLivre.value.length + ' / 2000';
    }

    function mostrarOuOcultarDadosContacto() {
      const opcaoSelecionada = form.querySelector(
        'input[name="interesseConsulta"]:checked'
      );

      const querConsulta =
        opcaoSelecionada &&
        opcaoSelecionada.value.indexOf('Sim, gostaria') === 0;

      if (querConsulta) {
        dadosContacto.classList.add('visivel');
        dadosContacto.setAttribute('aria-hidden', 'false');

        campoNome.required = true;
        campoTelefone.required = true;
        campoMelhorDia.required = true;
        campoMelhorHorario.required = true;
        campoConsentimento.required = true;

        botao.textContent = 'Enviar questão e pedido de contacto';
      } else {
        dadosContacto.classList.remove('visivel');
        dadosContacto.setAttribute('aria-hidden', 'true');

        campoNome.required = false;
        campoTelefone.required = false;
        campoMelhorDia.required = false;
        campoMelhorHorario.required = false;
        campoConsentimento.required = false;

        campoNome.value = '';
        campoTelefone.value = '';
        campoMelhorDia.value = '';
        campoMelhorHorario.value = '';
        campoConsentimento.checked = false;

        botao.textContent = 'Enviar a minha questão';
      }
    }

    questaoLivre.addEventListener('input', atualizarContador);

    form.querySelectorAll('input[name="interesseConsulta"]').forEach(function (opcao) {
      opcao.addEventListener('change', mostrarOuOcultarDadosContacto);
    });

    form.addEventListener('submit', async function (evento) {
      evento.preventDefault();

      mensagem.className = 'fdl-mensagem-menopausa';
      mensagem.textContent = '';

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      if (SCRIPT_URL === 'COLE_AQUI_O_URL_TERMINADO_EM_EXEC') {
        mensagem.className = 'fdl-mensagem-menopausa erro';
        mensagem.textContent =
          'Falta configurar o URL da aplicação Web no código do formulário.';
        return;
      }

      botao.disabled = true;
      botao.textContent = 'A enviar...';

      const dados = new FormData(form);

      try {
        await fetch(SCRIPT_URL, {
          method: 'POST',
          body: dados,
          mode: 'no-cors'
        });

        const pedidoConsulta =
          dados.get('interesseConsulta') &&
          dados.get('interesseConsulta').indexOf('Sim, gostaria') === 0;

        form.reset();
        dadosContacto.classList.remove('visivel');
        dadosContacto.setAttribute('aria-hidden', 'true');
        atualizarContador();
        botao.textContent = 'Enviar a minha questão';

        mensagem.className = 'fdl-mensagem-menopausa sucesso';

        mensagem.textContent = pedidoConsulta
          ? 'Obrigada. Recebemos a sua questão e o seu pedido de contacto. A nossa equipa irá contactá-la no período indicado.'
          : 'Obrigada por partilhar a sua questão. A nossa equipa irá analisá-la com todo o cuidado.';
      } catch (erro) {
        mensagem.className = 'fdl-mensagem-menopausa erro';
        mensagem.textContent =
          'Não foi possível enviar o formulário neste momento. Por favor, tente novamente.';
      } finally {
        botao.disabled = false;
      }
    });

    atualizarContador();
  });
</script>
